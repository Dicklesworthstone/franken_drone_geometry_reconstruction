{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdgr.dev/schemas/media_decode_plan.v1.json",
  "title": "FDGR authority-free media decode plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_digest",
    "source_root_manifest_digest",
    "source_manifest_digest",
    "source_object_digest",
    "source_object_length",
    "track_id",
    "start_sample",
    "max_samples",
    "pixel_format",
    "output_width",
    "output_height",
    "max_frames",
    "max_output_bytes",
    "max_wall_time_ms",
    "max_memory_bytes",
    "worker_executable_digest",
    "worker_version_digest",
    "profile_digest",
    "worker_threads",
    "network_allowed",
    "deterministic"
  ],
  "properties": {
    "schema": {
      "const": "fdgr.media_decode_plan/1"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_root_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_object_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_object_length": {
      "type": "integer",
      "minimum": 1
    },
    "track_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "start_sample": {
      "type": "integer",
      "minimum": 0
    },
    "max_samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "pixel_format": {
      "enum": ["gray8", "rgb24", "rgba", "yuv420p"]
    },
    "output_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "output_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "max_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_wall_time_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "max_memory_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "worker_executable_digest": {
      "$ref": "#/$defs/digest"
    },
    "worker_version_digest": {
      "$ref": "#/$defs/digest"
    },
    "profile_digest": {
      "$ref": "#/$defs/digest"
    },
    "worker_threads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "network_allowed": {
      "const": false
    },
    "deterministic": {
      "const": true
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    }
  }
}
