{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdgr.dev/schemas/semantic_observation.v1.json",
  "title": "FDGR Semantic Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_id",
    "basis",
    "ontology_root",
    "concept_id",
    "disposition",
    "supporting_evidence",
    "resolver_policy_root"
  ],
  "properties": {
    "schema": {
      "const": "fdgr.semantic_observation/1"
    },
    "observation_id": {
      "$ref": "#/$defs/digest"
    },
    "basis": {
      "$ref": "capture_anchor.schema.json"
    },
    "ontology_root": {
      "$ref": "#/$defs/digest"
    },
    "concept_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "disposition": {
      "enum": [
        "observation",
        "hypothesis",
        "resolved",
        "rejected",
        "indeterminate"
      ]
    },
    "supporting_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/digest"
      },
      "uniqueItems": true
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/digest"
      },
      "uniqueItems": true
    },
    "geometry_association_root": {
      "$ref": "#/$defs/digest"
    },
    "resolver_policy_root": {
      "$ref": "#/$defs/digest"
    },
    "human_confirmation_root": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
