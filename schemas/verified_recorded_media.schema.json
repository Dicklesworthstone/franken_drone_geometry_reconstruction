{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdgr.dev/schemas/verified_recorded_media.v1.json",
  "title": "FDGR independently verified recorded-media graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "closure_verified",
    "root_manifest_digest",
    "root_object_digest",
    "source",
    "inspection",
    "media"
  ],
  "properties": {
    "schema": {
      "const": "fdgr.verified_recorded_media/1"
    },
    "closure_verified": {
      "const": true
    },
    "root_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_object_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "$ref": "#/$defs/publication"
    },
    "inspection": {
      "$ref": "#/$defs/publication"
    },
    "media": {
      "$ref": "media_inspection.schema.json"
    }
  },
  "$defs": {
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "object_digest",
        "object_length",
        "chunk_size",
        "chunk_count"
      ],
      "properties": {
        "manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "object_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "object_length": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
