{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdgr.dev/schemas/geometry_generation.v1.json",
  "title": "FDGR Geometry Generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generation_root",
    "basis",
    "coordinate_frame",
    "scale_status",
    "representations",
    "uncertainty_root",
    "coverage_root",
    "publication_stage"
  ],
  "properties": {
    "schema": {
      "const": "fdgr.geometry_generation/1"
    },
    "generation_root": {
      "$ref": "#/$defs/digest"
    },
    "basis": {
      "$ref": "capture_anchor.schema.json"
    },
    "coordinate_frame": {
      "$ref": "#/$defs/coordinate_frame"
    },
    "scale_status": {
      "enum": [
        "relative_only",
        "estimated",
        "witnessed",
        "surveyed"
      ]
    },
    "scale_witness_root": {
      "$ref": "#/$defs/digest"
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "root",
          "authority"
        ],
        "properties": {
          "kind": {
            "enum": [
              "sparse_points",
              "dense_points",
              "surfels",
              "tsdf",
              "occupancy",
              "mesh",
              "gaussian_splats",
              "texture"
            ]
          },
          "root": {
            "$ref": "#/$defs/digest"
          },
          "authority": {
            "enum": [
              "canonical_geometry",
              "derived_geometry",
              "appearance_only"
            ]
          }
        }
      }
    },
    "uncertainty_root": {
      "$ref": "#/$defs/digest"
    },
    "coverage_root": {
      "$ref": "#/$defs/digest"
    },
    "publication_stage": {
      "enum": [
        "reserved",
        "materializing",
        "verified",
        "published",
        "aborted",
        "indeterminate"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handedness",
        "x_axis",
        "y_axis",
        "z_axis",
        "units",
        "transform_direction"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "handedness": {
          "enum": [
            "right",
            "left"
          ]
        },
        "x_axis": {
          "type": "string"
        },
        "y_axis": {
          "type": "string"
        },
        "z_axis": {
          "type": "string"
        },
        "units": {
          "enum": [
            "relative",
            "meters"
          ]
        },
        "transform_direction": {
          "type": "string"
        }
      }
    }
  }
}
