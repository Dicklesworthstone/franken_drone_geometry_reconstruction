{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdgr.dev/schemas/pose_graph_generation.v1.json",
  "title": "FDGR component-local pose graph generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generation_digest",
    "node_basis_digest",
    "edge_basis_digest",
    "graph_selection_policy_digest",
    "rotation_policy_digest",
    "topology_digest",
    "generation",
    "node_count",
    "edge_count",
    "component_count",
    "cycle_count",
    "translation_status",
    "policy",
    "forest_edge_ids",
    "bridge_edge_ids",
    "orientations",
    "cycle_assessments",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "fdgr.pose_graph_generation/1"
    },
    "generation_digest": {
      "$ref": "#/$defs/digest"
    },
    "node_basis_digest": {
      "$ref": "#/$defs/digest"
    },
    "edge_basis_digest": {
      "$ref": "#/$defs/digest"
    },
    "graph_selection_policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "rotation_policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "topology_digest": {
      "$ref": "#/$defs/digest"
    },
    "generation": {
      "$ref": "#/$defs/nonzero_safe_integer"
    },
    "node_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "edge_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500000
    },
    "component_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "cycle_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500000
    },
    "translation_status": {
      "const": "direction_only_scale_underdetermined"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "forest_edge_ids": {
      "$ref": "#/$defs/id_array"
    },
    "bridge_edge_ids": {
      "$ref": "#/$defs/id_array"
    },
    "orientations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/orientation"
      }
    },
    "cycle_assessments": {
      "type": "array",
      "maxItems": 500000,
      "items": {
        "$ref": "#/$defs/cycle"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonzero_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "optional_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nonzero_safe_integer"
        }
      ]
    },
    "id_array": {
      "type": "array",
      "maxItems": 500000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonzero_safe_integer"
      }
    },
    "matrix9": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "integer",
        "minimum": -2000000000,
        "maximum": 2000000000
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rotation_cycle_residual_ppm",
        "max_orientation_drift_ppm",
        "max_path_expansions"
      ],
      "properties": {
        "max_rotation_cycle_residual_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "max_orientation_drift_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "max_path_expansions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "sample_index",
        "component_root_node_id",
        "parent_node_id",
        "parent_edge_id",
        "rotation_node_from_root_nano"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nonzero_safe_integer"
        },
        "sample_index": {
          "$ref": "#/$defs/safe_integer"
        },
        "component_root_node_id": {
          "$ref": "#/$defs/nonzero_safe_integer"
        },
        "parent_node_id": {
          "$ref": "#/$defs/optional_id"
        },
        "parent_edge_id": {
          "$ref": "#/$defs/optional_id"
        },
        "rotation_node_from_root_nano": {
          "$ref": "#/$defs/matrix9"
        }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closing_edge_id",
        "rotation_residual_ppm",
        "status",
        "forest_path_edge_ids"
      ],
      "properties": {
        "closing_edge_id": {
          "$ref": "#/$defs/nonzero_safe_integer"
        },
        "rotation_residual_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "status": {
          "enum": [
            "consistent",
            "conflicting"
          ]
        },
        "forest_path_edge_ids": {
          "$ref": "#/$defs/id_array"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_root_node_id",
        "orientation_status",
        "node_ids",
        "edge_ids",
        "forest_edge_ids",
        "conflicting_edge_ids"
      ],
      "properties": {
        "component_root_node_id": {
          "$ref": "#/$defs/nonzero_safe_integer"
        },
        "orientation_status": {
          "enum": [
            "tree_only",
            "cycle_consistent",
            "conflicted"
          ]
        },
        "node_ids": {
          "$ref": "#/$defs/id_array"
        },
        "edge_ids": {
          "$ref": "#/$defs/id_array"
        },
        "forest_edge_ids": {
          "$ref": "#/$defs/id_array"
        },
        "conflicting_edge_ids": {
          "$ref": "#/$defs/id_array"
        }
      }
    }
  }
}
