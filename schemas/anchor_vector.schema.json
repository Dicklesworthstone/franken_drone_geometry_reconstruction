{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdgr.dev/schemas/anchor_vector.v1.json",
  "title": "FDGR Anchor Vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "property_lineage_id",
    "observation_epoch",
    "evidence_sequence",
    "capture_root",
    "evidence_root",
    "clock_epoch",
    "clock_model_root",
    "calibration_generation",
    "calibration_root",
    "scale_generation",
    "scale_authority",
    "scale_root",
    "pose_branch_id",
    "constraint_generation_root",
    "geometry_generation_root",
    "scene_generation_root",
    "ontology_root",
    "coverage_generation_root",
    "search_generation_root",
    "archive_generation_root",
    "question_graph_root",
    "work_ledger_root",
    "schema_root",
    "compatibility_epoch",
    "privacy_epoch",
    "policy_epoch",
    "policy_root",
    "capability_epoch",
    "adapter_profile_root",
    "model_registry_root",
    "anchor_digest"
  ],
  "properties": {
    "schema": { "const": "fdgr.anchor_vector/1" },
    "property_lineage_id": { "type": "string", "minLength": 1 },
    "observation_epoch": { "type": "integer", "minimum": 0 },
    "evidence_sequence": { "type": "integer", "minimum": 0 },
    "capture_root": { "$ref": "#/$defs/digest" },
    "evidence_root": { "$ref": "#/$defs/digest" },
    "clock_epoch": { "type": "integer", "minimum": 0 },
    "clock_model_root": { "$ref": "#/$defs/optional_digest" },
    "calibration_generation": { "type": "integer", "minimum": 0 },
    "calibration_root": { "$ref": "#/$defs/optional_digest" },
    "scale_generation": { "type": "integer", "minimum": 0 },
    "scale_authority": {
      "enum": ["relative_only", "estimated", "witnessed", "surveyed"]
    },
    "scale_root": { "$ref": "#/$defs/optional_digest" },
    "pose_branch_id": { "type": "string", "minLength": 1 },
    "constraint_generation_root": { "$ref": "#/$defs/optional_digest" },
    "geometry_generation_root": { "$ref": "#/$defs/optional_digest" },
    "scene_generation_root": { "$ref": "#/$defs/optional_digest" },
    "ontology_root": { "$ref": "#/$defs/optional_digest" },
    "coverage_generation_root": { "$ref": "#/$defs/optional_digest" },
    "search_generation_root": { "$ref": "#/$defs/optional_digest" },
    "archive_generation_root": { "$ref": "#/$defs/optional_digest" },
    "question_graph_root": { "$ref": "#/$defs/optional_digest" },
    "work_ledger_root": { "$ref": "#/$defs/digest" },
    "schema_root": { "$ref": "#/$defs/digest" },
    "compatibility_epoch": { "type": "integer", "minimum": 0 },
    "privacy_epoch": { "type": "integer", "minimum": 0 },
    "policy_epoch": { "type": "integer", "minimum": 0 },
    "policy_root": { "$ref": "#/$defs/digest" },
    "capability_epoch": { "type": "integer", "minimum": 0 },
    "adapter_profile_root": { "$ref": "#/$defs/optional_digest" },
    "model_registry_root": { "$ref": "#/$defs/digest" },
    "anchor_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "optional_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
