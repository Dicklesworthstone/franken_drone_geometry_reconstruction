{
  "schema": "fdgr.doodlestein_job_graph/1",
  "revision": 2,
  "authority": "local_receipts_only",
  "hosted_github_actions_authority": false,
  "resumption_key": [
    "fdgr_source_tree",
    "source_closure_root",
    "toolchain",
    "contract_root",
    "host_profile",
    "input_roots"
  ],
  "jobs": [
    {
      "id": "repo-policy",
      "needs": [],
      "command": "python3 scripts/validate_repo.py",
      "host": "any-local"
    },
    {
      "id": "dependency-policy",
      "needs": [
        "repo-policy"
      ],
      "command": "python3 scripts/check_dependency_policy.py",
      "host": "any-local"
    },
    {
      "id": "generated-contracts",
      "needs": [
        "repo-policy"
      ],
      "command": "python3 scripts/generate_traceability.py --check && python3 scripts/export_beads_bootstrap.py --output .beads/bootstrap.jsonl --check",
      "host": "any-local"
    },
    {
      "id": "rust-core",
      "needs": [
        "dependency-policy",
        "generated-contracts"
      ],
      "command": "cargo fmt --all --check && cargo check --workspace --all-targets --locked && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --all-targets --locked",
      "host": "target-native"
    },
    {
      "id": "agent-contract",
      "needs": [
        "rust-core"
      ],
      "command": "python3 scripts/validate_agent_contracts.py",
      "host": "target-native"
    },
    {
      "id": "agent-scenarios",
      "needs": [
        "agent-contract"
      ],
      "command": "cargo test --workspace --all-targets --locked agent_",
      "host": "target-native"
    },
    {
      "id": "promotion",
      "needs": [
        "agent-scenarios"
      ],
      "command": "python3 scripts/emit_local_qualification_receipt.py --out qualification/fdgr-local-qualification.json",
      "host": "release-coordinator",
      "receipt_semantics": "identity_seal_after_successful_predecessor_receipts; not standalone qualification proof"
    }
  ],
  "promotion_rule": "No partial job graph or hosted badge may publish a release root."
}
