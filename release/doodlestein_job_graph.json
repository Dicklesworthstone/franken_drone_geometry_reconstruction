{
  "schema": "fdgr.doodlestein_job_graph/1",
  "revision": 4,
  "authority": "local_receipts_only",
  "hosted_github_actions_authority": false,
  "resumption_key": [
    "fdgr_source_tree",
    "source_closure_root",
    "toolchain",
    "contract_root",
    "host_profile",
    "input_roots"
  ],
  "jobs": [
    {
      "id": "repo-policy",
      "needs": [],
      "command": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/validate_repo.py",
      "host": "any-local"
    },
    {
      "id": "registry-contracts",
      "needs": [
        "repo-policy"
      ],
      "command": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/test_registry_contracts.py",
      "host": "any-local",
      "receipt_semantics": "immutable mutation-suite evidence input; never standalone release authority"
    },
    {
      "id": "dependency-policy",
      "needs": [
        "repo-policy",
        "registry-contracts"
      ],
      "command": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/check_dependency_policy.py",
      "host": "any-local"
    },
    {
      "id": "generated-contracts",
      "needs": [
        "repo-policy",
        "registry-contracts"
      ],
      "command": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/generate_traceability.py --check && PYTHONDONTWRITEBYTECODE=1 python3 scripts/export_beads_bootstrap.py --output .beads/bootstrap.jsonl --check",
      "host": "any-local"
    },
    {
      "id": "rust-core",
      "needs": [
        "dependency-policy",
        "generated-contracts",
        "registry-contracts"
      ],
      "command": "cargo fmt --all --check && cargo check --workspace --all-targets --locked && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --all-targets --locked",
      "host": "target-native"
    },
    {
      "id": "agent-contract",
      "needs": [
        "rust-core"
      ],
      "command": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/validate_agent_contracts.py",
      "host": "target-native"
    },
    {
      "id": "agent-scenarios",
      "needs": [
        "agent-contract"
      ],
      "command": "cargo test --workspace --all-targets --locked agent_",
      "host": "target-native"
    },
    {
      "id": "keyframe-e2e",
      "needs": [
        "agent-scenarios"
      ],
      "command": "bash scripts/e2e/keyframe_select.sh",
      "host": "target-native"
    },
    {
      "id": "correspondence-e2e",
      "needs": [
        "keyframe-e2e"
      ],
      "command": "bash scripts/e2e/correspondence_build.sh",
      "host": "target-native"
    },
    {
      "id": "epipolar-e2e",
      "needs": [
        "correspondence-e2e"
      ],
      "command": "bash scripts/e2e/epipolar_verify.sh",
      "host": "target-native"
    },
    {
      "id": "relative-pose-e2e",
      "needs": [
        "epipolar-e2e"
      ],
      "command": "bash scripts/e2e/relative_pose_verify.sh",
      "host": "target-native"
    },
    {
      "id": "pose-graph-e2e",
      "needs": [
        "relative-pose-e2e"
      ],
      "command": "bash scripts/e2e/pose_graph_build.sh",
      "host": "target-native"
    },
    {
      "id": "edge-scale-e2e",
      "needs": [
        "pose-graph-e2e"
      ],
      "command": "bash scripts/e2e/edge_scale_resolve.sh",
      "host": "target-native"
    },
    {
      "id": "promotion",
      "needs": [
        "edge-scale-e2e"
      ],
      "command": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/emit_local_qualification_receipt.py --out qualification/fdgr-local-qualification.json",
      "host": "release-coordinator",
      "receipt_semantics": "identity_seal_after_successful_predecessor_receipts; not standalone qualification proof"
    }
  ],
  "promotion_rule": "No partial job graph, mutation-suite receipt, or hosted badge may publish a release root."
}
